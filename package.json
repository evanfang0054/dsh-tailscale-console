{
  "name": "dsh-tailscale-console",
  "version": "0.2.3",
  "description": "DeepSeek Harness 的 Tailscale 远程访问运营面板：健康检查、HTTPS 入口开关、macOS 代理绕过、中继服务器运维、ACL 片段生成。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "tailscale",
    "deepseek-harness",
    "plugin",
    "remote-access"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.4.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/evanfang0054/dsh-tailscale-console.git"
  },
  "homepage": "https://github.com/evanfang0054/dsh-tailscale-console#readme",
  "bugs": {
    "url": "https://github.com/evanfang0054/dsh-tailscale-console/issues"
  }
}
